n.Cores      = 16,  # parallel workers and model runs per generation
maxgen       = 3,   # maximum number of generations; increase for production
master       = here::here("inputs","model_configuration"),
run          = here::here("RUN"),
restart.file = here::here("inputs","restart_file"),
track.path   = here::here("outputs", "keep_track_calibration"), # parameter files of each run
REPORT = 1,    # number of iterations to run before saving a restart
parallel = FALSE, #run as parallel
no.trace = 3, #global fitness and partial fitness
# arguments of run_model(), relative to the master directory
prefix        = "outputFolder/outputSETAS",            # -o outputSETAS.nc, -d outputFolder
fg.file       = fg.file,
biom.indx     = "outputFolder/outputSETASBiomIndx.txt", # written by each run
run.prm       = run.prm,
dt.timeseries = dt.timeseries
)
results <- atlantiscalibration::run_calibration(calibration)
control  <- calibration$control
objfn    <- calibration$objfn
forcing  <- calibration$forcing
observed <- calibration$observed
setup    <- calibration$setup
cl <- parallel::makeCluster(control$nCores)
doSNOW::registerDoSNOW(cl)
on.exit(parallel::stopCluster(cl), add = TRUE)
# Objects required on each worker
parallel::clusterExport(cl, varlist = c("control", "objfn", "forcing", "observed", "setup"),
envir = environment())
# Libraries required on each worker
for (pkg in c("atlantiscalibration", "calibrar", "stringr")){
parallel::clusterCall(cl, library, pkg, character.only = TRUE)
}
lbfgsb1 <- calibrar::calibrate(
par     = forcing[["paropt"]],
fn      = objfn,
method  = "AHR-ES",
lower   = forcing[["parmin"]],
upper   = forcing[["parmax"]],
phases  = forcing[["parphase"]],
control = control,
parallel = TRUE
)
